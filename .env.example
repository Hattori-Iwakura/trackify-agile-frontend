# API qua Next (cùng origin) — src/app/api proxy sang Nest
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Socket.io tới Nest (không thêm /api)
NEXT_PUBLIC_WS_URL=http://localhost:4000

# Nest cho proxy (server-side, mặc định 4000)
# BACKEND_ORIGIN=http://127.0.0.1:4000

# Avatar/uploads từ Nest
# NEXT_PUBLIC_UPLOAD_ORIGIN=http://localhost:4000
