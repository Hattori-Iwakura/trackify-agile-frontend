NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_WS_URL=http://localhost:3000

# Optional: comma-separated first segments after /api/ (e.g. auth,users,projects). Empty = allow all.
# NEST_PROXY_ALLOWLIST=auth,users,projects,notifications

# Optional: proxy timeout (ms). If unset: 15000 for GET/HEAD, 120000 for other methods.
# NEST_PROXY_TIMEOUT_MS=60000
